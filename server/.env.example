# 复制为 .env 后修改
PORT=8080
# 访问令牌（H5「更多 → 后端策略引擎」里填写同一个值）。公网部署必须设置！
API_TOKEN=请改成一串足够长的随机字符串
# 允许访问的前端来源
CORS_ORIGIN=https://xinc76599-sys.github.io
# 用于加密交易所 API Key 的主密钥（64位十六进制）：openssl rand -hex 32
MASTER_KEY=
# 实盘开关：默认 false（仅模拟盘）。设为 true 前请务必先用模拟盘验证策略
LIVE_TRADING=false
# 实盘单笔最大名义价值（USDT），超过按上限下单
MAX_LIVE_NOTIONAL=50
# 实盘交易所（ccxt id），如 binance / okx
LIVE_EXCHANGE=binance
# 模拟盘初始资金、轮询间隔
INITIAL_BALANCE=10000
TICK_MS=4000
